# ── Elevate CRM environment ──────────────────────────────────────────────
# Copy to `.env` (or export in your shell) before first run.

# Admin account. REQUIRED to use the app — there are NO hardcoded defaults.
# If these are unset, the server logs a setup message and login returns a
# clear "setup required" response instead of letting anyone in.
ADMIN_EMAIL=owner@elevate.studio
ADMIN_PASSWORD=change-me-to-a-strong-password

# Port the server binds. Use 3001 locally — port 3000 is the live agency
# site and must never be used by this app.
PORT=3001

# Optional: session signing secret. If unset, a random one is generated and
# persisted to data/.secret so sessions survive restarts. Set it explicitly
# in production (e.g. from your host's secret store).
# SESSION_SECRET=

# Set "true" when serving over HTTPS in production (sets the Secure cookie flag).
# COOKIE_SECURE=false

# Where the SQLite database file lives. Defaults to ./data (project-local).
# Point this at a persistent volume in production.
# DATA_DIR=./data
