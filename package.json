{
  "name": "elevate-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elevate Studio CRM — universal client pipeline management app (product track).",
  "scripts": {
    "build": "bun build ./index.html --outdir ./dist --minify",
    "start": "bun ./server/index.ts",
    "start:local": "PORT=3001 bun ./server/index.ts",
    "dev": "PORT=3001 bun --watch ./server/index.ts",
    "seed": "bun ./server/seed.ts",
    "db:reset": "rm -f data/crm.db data/crm.db-shm data/crm.db-wal"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
